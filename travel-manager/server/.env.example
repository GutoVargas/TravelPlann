# Integração HaFFas (BuscaPassagem.com) — opcional
# Se a HaFFas/BuscaPassagem exigir credenciais, coloque a chave aqui e renomeie para .env
BUSCAPASSAGEM_KEY=
# Override da URL do endpoint de busca (caso eles mudem a rota)
# HAFFAS_BASE_URL=https://www.buscapassagem.com.br/v2/api/public/search

# Integração HAFAS Europa (trens) — opcional
# Proxy autenticado seu (se rodar em rede bloqueada): prefixo que recebe ?url=<endpoint>
# TRAINS_PROXY_URL=https://meu-proxy.example.com/?url=
# Override dos endpoints do bahn.de / proxy comunitário:
# TRAINS_BASE_URL=https://www.bahn.de/web/api/automated-trip-production/product/DE/db/regioTripSearch/rest/search
# TRANSPORT_REST=https://v6.db.transport.rest
