# ===== Google Maps Platform (rotas, mapas, tempos de deslocamento) =====
# Crie a chave em https://console.cloud.google.com/apis/credentials
# Habilite: Routes API, Places API (New) e Maps Embed API.
GOOGLE_MAPS_API_KEY=

# Chave usada no mapa embutido (iframe) — pode ser a MESMA chave acima se
# "Maps Embed API" estiver habilitada; defina apenas se quiser separar por segurança.
GOOGLE_MAPS_EMBED_KEY=

# Caminho alternativo do banco SQLite (opcional)
# DB_FILE=./data/viajamaiss.db
